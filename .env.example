# Copy this file to ".env" and fill in your own values.
# NEVER commit the real .env file (it is listed in .gitignore).
# No quotes, no spaces around "=".

# data.gov.in API key (My Account -> API key)
DATA_GOV_API_KEY=your_data_gov_in_api_key_here

# AWS credentials of a dedicated IAM user limited to the bucket below
AWS_ACCESS_KEY_ID=your_aws_access_key_id_here
AWS_SECRET_ACCESS_KEY=your_aws_secret_access_key_here
AWS_DEFAULT_REGION=ap-south-1

# S3 bucket used as the raw (bronze) archive
S3_BUCKET=your-bucket-name-here